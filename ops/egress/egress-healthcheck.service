[Unit]
Description=Egress Proxy Healthcheck Service
After=network.target

[Service]
Type=oneshot
User=nobody
Group=nogroup
WorkingDirectory=/opt/cliproxy/ops/egress
EnvironmentFile=-/etc/default/egress-proxy.env
ExecStart=/usr/bin/python3 /opt/cliproxy/ops/egress/healthcheck.py --json
StandardOutput=journal
StandardError=journal
TimeoutSec=30
Restart=no

[Install]
WantedBy=multi-user.target
