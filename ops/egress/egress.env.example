# Example Environment Configuration for Egress Healthcheck and Node Selection
# All values use documentation-safe placeholders; replace with environment-specific values.

# ==========================================
# Healthcheck Configuration (healthcheck.py)
# ==========================================

# Outbound proxy URL through which health checks are routed (HTTP/HTTPS)
PROXY_URL=http://127.0.0.1:7890

# Expected public egress IP (RFC 5737 documentation placeholder; leave empty to skip IP validation)
EXPECTED_EGRESS_IP=198.51.100.1

# Endpoint used to query current public egress IP
IP_CHECK_URL=https://checkip.example.com/

# Connectivity check endpoints (secret-free generic URLs)
GOOGLE_CHECK_URL=https://google-check.example.com/generate_204
OAUTH_CHECK_URL=https://oauth.example.com/healthz
CLOUD_CODE_CHECK_URL=https://cloudcode.example.com/v1/status

# Timeout per endpoint check in seconds
CHECK_TIMEOUT=5.0

# Number of repeated healthcheck rounds per invocation
REPEAT_CHECKS=3

# Maximum allowable failed rounds before declaring healthcheck failure
FAILURE_THRESHOLD=1

# ==========================================
# Node Selection Configuration (select_node.py)
# ==========================================

# Local proxy controller API endpoint
NODE_API_BASE_URL=http://127.0.0.1:9090

# Optional authentication token for the local controller API (Bearer token)
NODE_API_TOKEN=example_token_placeholder

# Proxy selector / group name to manage
SELECTOR_NAME=GLOBAL

# Comma-separated list of allowed country/region prefixes
ALLOWED_COUNTRY_PREFIX=US,HK,JP

# Comma-separated list of preferred node name substrings in priority order
PREFERRED_NODE_NAMES=Fast,Premium,Direct

# Concurrency for probing candidate node latencies
PROBE_CONCURRENCY=5

# Latency probe timeout in milliseconds
PROBE_TIMEOUT_MS=3000

# URL used for controller latency delay testing
DELAY_TEST_URL=https://delay-check.example.com/generate_204

# Number of post-selection healthcheck rounds required to verify candidate stability
POST_SELECT_HEALTH_ROUNDS=2

# Delay between post-selection verification rounds in seconds
POST_SELECT_HEALTH_INTERVAL=0.5
